# ============================================
# MimoVision-Agent 配置文件
# ============================================

# MiMo API 配置
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_VISION_MODEL=mimo-v2-omni
MIMO_REASONING_MODEL=mimo-v2.5-pro
MIMO_FAST_MODEL=mimo-v2-flash

# Binance Futures API
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com

# Yahoo Finance (免费，无需Key)
YAHOO_FINANCE_ENABLED=true

# 新闻数据源
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
FEAR_GREED_API=https://api.alternative.me/fng/
COINGECKO_API=https://api.coingecko.com/api/v3

# Telegram Bot
TG_BOT_TOKEN=
TG_CHAT_ID=

# 风险控制参数
MAX_POSITION_PCT=15
MIN_POSITION_PCT=5
DEFAULT_LEVERAGE=20
MAX_LEVERAGE=50
STOP_LOSS_ATR_MULT=2.5
TAKE_PROFIT_ATR_MULT=4.0
RISK_PER_TRADE_PCT=2

# 分析参数
DEFAULT_TIMEFRAMES=1H,4H,1D
NEWS_COUNT=5
SENTIMENT_SCALE=-5,+5
TECHNICAL_INDICATORS=RSI,MACD,BB,KDJ,EMA,ATR

# Web服务
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_DEBUG=false

# 日志
LOG_LEVEL=INFO
LOG_FILE=logs/mimovision.log
