# MimoVision-Agent v2 配置

# MiMo API (小米大模型)
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_VISION_MODEL=mimo-v2-omni
MIMO_REASONING_MODEL=mimo-v2.5-pro
MIMO_FAST_MODEL=mimo-v2-flash

# Binance API (合约数据)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com

# Telegram Bot
TG_BOT_TOKEN=
TG_CHAT_ID=

# Brave Search (新闻)
BRAVE_API_KEY=

# 风控参数
MAX_POSITION_PCT=15
MIN_POSITION_PCT=5
DEFAULT_LEVERAGE=20
MAX_LEVERAGE=50
STOP_LOSS_ATR_MULT=2.5
TAKE_PROFIT_ATR_MULT=4.0
RISK_PER_TRADE_PCT=2

# 分析参数
DEFAULT_TIMEFRAMES=1H,4H,1D
NEWS_COUNT=5
TECHNICAL_INDICATORS=RSI,MACD,BB,KDJ,EMA,ATR

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_DEBUG=false

# 日志
LOG_LEVEL=INFO
LOG_FILE=logs/mimovision.log
